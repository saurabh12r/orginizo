rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /tasks_by_user/{username}/tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
